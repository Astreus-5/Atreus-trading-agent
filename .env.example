# ── Universal LLM Engine (Configure any ONE of the following) ────────────────
# 1. Anthropic Claude (e.g. claude-3-5-sonnet-20241022):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. OpenAI GPT (e.g. gpt-4o, gpt-4o-mini):
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o

# 3. Google Gemini (e.g. gemini-1.5-pro, gemini-1.5-flash):
# GOOGLE_API_KEY=AIzaSy...
# GOOGLE_MODEL=gemini-1.5-pro

# 4. OpenRouter (e.g. DeepSeek, Llama 3):
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=deepseek/deepseek-chat

# ── Binance Sub-Account API Credentials (Required) ────────────────────────────
# Create a dedicated sub-account in Binance → Account → Sub-Accounts, then generate
# a trade-only API key for it. Never use your main account key here.
BINANCE_SUB_ACCOUNT_API_KEY=your_subaccount_api_key
BINANCE_SUB_ACCOUNT_API_SECRET=your_subaccount_api_secret

# ── Pre-Trade RiskGuard Controls (Customizable) ──────────────────────────────
MAX_POSITION_PCT=5         # Maximum % of total account balance per single trade
MAX_LEVERAGE=5             # Maximum allowed leverage for futures positions
STOP_LOSS_PCT=2            # Minimum required stop-loss distance %
DAILY_LOSS_LIMIT_PCT=10    # Maximum daily drawdown circuit breaker %

# ── Binance MCP Engine (Optional / Future-Ready) ─────────────────────────────
# Set to true to activate official Binance Agent OS MCP Server connection:
ENABLE_BINANCE_MCP=false
# BINANCE_MCP_TOKEN=       # Optional: pre-generated OAuth Bearer token

